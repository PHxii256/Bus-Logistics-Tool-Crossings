{
  "_comment": "Crossings experiment: walk network + synthetic crossing overlay.",

  "school": {
    "name": "Victory College School",
    "latitude": 29.964406,
    "longitude": 31.270319
  },

  "n_students": 60,
  "seed": 42,

  "stage_distribution": {
    "KG": 0.0,
    "ELEMENTARY": 0.0,
    "MIDDLE": 0.5,
    "HIGH": 0.5
  },

  "stage_walk_limits": {
    "KG": 0,
    "ELEMENTARY": 0,
    "MIDDLE": 400,
    "HIGH": 400
  },

  "buses": {
    "count": 4,
    "capacity": 22
  },

  "constraints": {
    "enabled": true,
    "ride_time_multiplier": 3,
    "floor_minutes": 30,
    "ceiling_minutes": 60,
    "daily_detour_budget_minutes": 5,
    "bidirectional_check": true
  },

  "walk_graph": {
    "enabled": true,
    "radius_km": 2.0
  },

  "synthetic_crossings": {
    "enabled": true,
    "strategy": "per_drive_node",
    "min_dist_m": 6.0,
    "max_dist_m": 20.0,
    "max_per_drive_node": 1,
    "require_dual_carriageway": true,
    "min_opposite_bearing_deg": 150.0,
    "require_perpendicular_crossing": true,
    "min_perpendicular_deg": 65.0,
    "max_perpendicular_deg": 115.0,
    "max_existing_path_m": 80.0,
    "max_total": 60
  },

  "algorithm": {
    "iterations": 60,
    "time_budget_seconds": 60,
    "max_candidates_per_student": 4,
    "minimize_buses": true
  },

  "annulus": {
    "peak_km": 2.0,
    "sigma_km": 1.0,
    "min_km": 0.4,
    "max_km": 5.0
  },

  "output": "comparison_map.html",

  "debug": {
    "run_mode_a": true,
    "run_mode_b": true,
    "run_mode_c": true
  }
}
