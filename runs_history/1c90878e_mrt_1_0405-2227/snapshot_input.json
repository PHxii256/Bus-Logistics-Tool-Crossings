{
  "_comment": "Crossings experiment: walk network + synthetic crossing overlay.",

  "school": {
    "name": "Victory College School",
    "latitude": 29.964406,
    "longitude": 31.270319
  },

  "n_students": 100,
  "seed": 2000,

  "stage_distribution": {
    "KG": 0.25,
    "ELEMENTARY": 0.25,
    "MIDDLE": 0.25,
    "HIGH": 0.25
  },

  "stage_walk_limits": {
    "KG": 0,
    "ELEMENTARY": 0,
    "MIDDLE": 250,
    "HIGH": 500
  },

  "buses": {
    "count": 10,
    "capacity": 28
  },

  "graph": {
    "bbox": [29.753694770217, 31.214796485023, 30.201444959827, 31.466764435799],
    "boundary_mode": "polygon",
    "boundary_polygon_path": "cairo_boundaries/cairo_boundary_points.csv",
    "pkl_path": "",
    "cache": {
      "enabled": true
    }
  },

  "constraints": {
    "enabled": true,
    "ride_time_multiplier": 2,
    "floor_minutes": 30,
    "ceiling_minutes": 60,
    "daily_detour_budget_minutes": 10,
    "bidirectional_check": true,
    "mrt_enabled": true,
    "mrt": 60,
    "acceptable_offset_minutes": 30
  },
    
  "walk_graph": {
    "enabled": true,
    "coverage_mode": "bbox_strict",
    "bbox_radius_scale": 1.0,
    "radius_km": 10.0,
    "cache": {
      "enabled": true
    }
  },

  "synthetic_crossings": {
    "enabled": true,
    "strategy": "drive_node_crossings",
    "min_dist_m": 0.0,
    "max_dist_m": 60.0,
    "min_opposite_bearing_deg": 70.0,
    "max_crossing_angle_delta_deg": 30.0,
    "min_perpendicular_deg": 10.0,
    "max_perpendicular_deg": 200.0,
    "min_spacing_m": 30.0,
    "min_spacing_per_road_m": 30.0,
    "max_per_road": 600,
    "show_only_used": false,
    "max_total": 3000,
    "enable_guaranteed_connection": true,
    "guaranteed_connection_distance_m": 6.0,
    "fallback_mode": "adaptive",
    "cache": {
      "enabled": true
    }
  },

  "crossings_injection": {
    "enabled": true,
    "pkl_path": "cache/crossings_3eab1f2e_0403-2023.pkl",
    "strict_validation": false
  },

  "distance_matrix_cache": {
    "enabled": false,
    "pkl_path": ""
  },

"algorithm": {
    "iterations": 5000,
    "time_budget_seconds": 720,
    "min_iterations_floor": 50,
    "max_candidates_per_student": 5,
    "minimize_buses": false,
    "repair_max_unassigned_per_call": 32,
    "regret_scan_limit": 12,
    "max_repair_seconds_per_iteration": 2,
    "early_stop_patience": 80,
    "early_stop_min_improvement": 5,
    "early_stop_freeze_temp": 2,
    "early_stop_freeze_patience": 16,
    "fleet_search_followup_k_budget_scale": 0.6,
    "fleet_search_max_per_k_seconds": 75
  },

  "annulus": {
    "peak_km": 5.0,
    "sigma_km": 2.0,
    "min_km": 1.0,
    "max_km": 12,
    "dynamic_max_km": false,
    "auto_from_bbox_circle": false,
    "auto_peak_km": false,
    "auto_sigma_km": false,
    "peak_ratio": 0.25,
    "sigma_ratio": 0.18,
    "bbox_radius_scale": 1.0,
    "max_attempts_per_student": 12000,
    "attempts_log_every": 25000
  },

  "output": "comparison_map.html",

  "debug": {
    "run_mode_a": false,
    "run_mode_b": true,
    "run_mode_c": false,
    "run_build_map": true,
    "visualize_walk_graph": {
      "enabled": false,
      "sample_rate": 0.1
    },
    "_comment": "visualize_walk_graph: enabled=true/false, sample_rate=1.0 (all edges) or 0.2 (20% sample)"
  }
}
